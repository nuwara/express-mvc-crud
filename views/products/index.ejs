<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Products - Homepage</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="styles.css">
    </head>
  <body>
    <div class="container">
        <header>
            <nav class="navbar navbar-expand-lg ">
                <div class="container-fluid">
                    
                    <a class="navbar-brand" href="#">Navbar</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="#">Home</a>
                            </li>
                            
                        </ul>
                    </div>
                    
                </div>
            </nav>
        </header>
        <main>
            <h1>Products - Homepage</h1>

            <% if(sessionMessage){%>
                <div class="alert alert-success">
                    <%= sessionMessage %>
                </div>    
            <%} %>
           
            <a href="/products/create" class="btn btn-secondary mb-2"> New record </a>
            <a href="/" class="btn btn-info mb-2"> Homepage </a>
            <% if(products.length > 0){%>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th colspan="2">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(product=>{%>
                        <tr>
                            <td><%= product.name %></td>
                            <td><%= product.description %></td>
                            <td><%= product.quantity %></td>
                            <td><%= product.price %></td>
                            <td><a href="/products/edit/<%= product.id %>" class="btn btn-outline-primary">Edit</a></td>
                            <td>
                                <form action="/products/delete/<%= product.id %>" method="post">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" onclick="return confirm('Are you sure to delete?')" class="btn btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    
                    <%}) %>
                </tbody>
            </table>
            <% }else{%>
                <h5 class="text-danger text-center">No record found</h5>
            <%} %>
        </main>
        <footer>
            <p>Copyright &copy; <%= new Date().getFullYear() %></p>
        </footer>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>